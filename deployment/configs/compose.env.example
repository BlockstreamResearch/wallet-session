# Copy to ./configs/compose.env and edit. This is the only file the stack
# needs; values are rendered into the relay configuration at container start.
# Any further relay setting can be added here as SECTION__KEY=value, for
# example LIMITS__MAX_SESSIONS=1000. Raising LIMITS__MAX_CONNECTIONS also
# needs worker_connections raised in the nginx main config (README: Capacity).

# Audience the relay accepts in connection tokens. Required: clients sign
# their tokens with this `aud`, and the relay refuses to start without it.
APPLICATION_AUDIENCE=wss://relay.example.com

# Port published by nginx. Normally behind a load balancer or CDN that speaks
# HTTPS/WSS; with nothing in front, run docker-compose.direct.yml as well.
RELAY_PUBLIC_PORT=8080

# Ports inside the relay container: the WebSocket listener and the probes.
RELAY_PORT=8080
HEALTH_PORT=8081

# Longest remaining lifetime accepted in a connection token, in seconds.
MAX_TOKEN_LIFETIME_SECONDS=600

# Per-source connection and request limits at the proxy, keyed on the client's
# IPv4 address or IPv6 /64. They count only complete requests unless
# docker-compose.direct.yml also caps connections at accept (README).
PER_IP_CONNECTIONS=64
PER_IP_RATE=5
PER_IP_BURST=20

# Required: the range allowed to assert a client address through
# X-Forwarded-For (real_ip). Uncomment and set it to the load balancer / CDN
# range when TLS terminates upstream, or to 127.0.0.1/32 when nothing sits in
# front of this stack (docker-compose.direct.yml then takes the client address
# from its own front instead).
#TRUSTED_PROXY_CIDR=127.0.0.1/32
