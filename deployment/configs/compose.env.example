# Copy to ./configs/compose.env and edit. This is the only file the stack
# needs; values are rendered into the relay configuration at container start.
# Any further relay setting can be added here as SECTION__KEY=value, for
# example LIMITS__MAX_SESSIONS=1000.

# Audience the relay accepts in connection tokens. Required: clients sign
# their tokens with this `aud`, and the relay refuses to start without it.
APPLICATION_AUDIENCE=wss://relay.example.com

# Port published by nginx. TLS terminates in front of this stack, so this is
# normally behind a load balancer or CDN that speaks HTTPS/WSS.
RELAY_PUBLIC_PORT=8080

# Ports inside the relay container: the WebSocket listener and the probes.
RELAY_PORT=8080
HEALTH_PORT=8081

# Longest remaining lifetime accepted in a connection token, in seconds.
MAX_TOKEN_LIFETIME_SECONDS=600

# Per-source connection and request limits at the proxy.
PER_IP_CONNECTIONS=64
PER_IP_RATE=5
PER_IP_BURST=20

# Required: the range allowed to assert a client address through
# X-Forwarded-For (real_ip). Uncomment and set it to 127.0.0.1/32 when nothing
# sits in front of this stack, or to the load balancer / CDN range when TLS
# terminates upstream.
#TRUSTED_PROXY_CIDR=127.0.0.1/32
