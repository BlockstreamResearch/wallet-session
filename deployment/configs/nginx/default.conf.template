# Rendered into /etc/nginx/conf.d/default.conf by the nginx image entrypoint,
# which substitutes the environment variables that are set.
#
# The stock image includes this file inside its own `http {}` block, so it
# holds http-level directives only (no `events` or `http` wrapper).

log_format relay '$remote_addr - $time_iso8601 "$request_method $uri" $status $body_bytes_sent "$http_user_agent"';

set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_req_zone  $binary_remote_addr zone=perip_rate:10m rate=${PER_IP_RATE}r/s;

# WebSocket connections are upgraded, plain requests are closed normally.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    access_log /dev/stdout relay;
    error_log /dev/stderr crit;

    location / {
        limit_conn perip ${PER_IP_CONNECTIONS};
        limit_req  zone=perip_rate burst=${PER_IP_BURST} nodelay;

        proxy_pass http://relay:${RELAY_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Relay frames are interactive; do not buffer them, and keep the
        # tunnel open well past the relay's 30 second keepalive pings.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
