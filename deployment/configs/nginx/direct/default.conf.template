# Rendered into /etc/nginx/conf.d/default.conf by the nginx image entrypoint
# when docker-compose.direct.yml is in use (nothing in front of this stack).
# Clients reach this server only through the stream front in
# edge.conf.stream-template, which caps connections per client address at
# accept and passes the client address in a PROXY protocol header over a local
# unix socket.

log_format relay '$remote_addr - $time_iso8601 "$request_method $uri" $status $body_bytes_sent "$http_user_agent"';

# The client address comes from the front's PROXY protocol header only;
# X-Forwarded-For from clients is never trusted here.
set_real_ip_from unix:;
real_ip_header proxy_protocol;

# Per-source key: the whole IPv4 address, or the /64 prefix of an IPv6 address,
# since one subscriber or LAN normally holds a whole /64. IPv4-mapped IPv6
# addresses keep the whole address so that they do not all share one key.
map $binary_remote_addr $relay_limit_key {
    "~(?s)^\x00{10}\xff\xff.{4}\z"            $binary_remote_addr;
    "~(?s)^(?<relay_v6_prefix>.{8}).{8}\z"    $relay_v6_prefix;
    default                                   $binary_remote_addr;
}

limit_conn_zone $relay_limit_key zone=perip:10m;
limit_req_zone  $relay_limit_key zone=perip_rate:10m rate=${PER_IP_RATE}r/s;

# WebSocket connections are upgraded, plain requests are closed normally.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen unix:/run/nginx-edge/http.sock proxy_protocol;
    server_name _;

    # Bound how long a connection may take to send its request header (nginx
    # default: 60 s, counted from accept). The front closes the client side
    # when this server closes its side.
    client_header_timeout 10s;

    access_log /dev/stdout relay;
    # nginx appends the request line, which carries the connection token and
    # topic, to every error-log message raised while handling a request, at
    # every level: upstream failures and rate-limit rejections at error, pool
    # and descriptor exhaustion at alert. Only emerg withholds it.
    error_log /dev/stderr emerg;

    location / {
        # The front already caps connections per source at accept; these
        # still pace requests and bound concurrent requests per source.
        limit_conn perip ${PER_IP_CONNECTIONS};
        limit_req  zone=perip_rate burst=${PER_IP_BURST} nodelay;

        proxy_pass http://relay:${RELAY_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Nothing trusted sits in front, so a client-supplied chain is
        # replaced rather than extended.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Relay frames are interactive; do not buffer them, and keep the
        # tunnel open well past the relay's 30 second keepalive pings.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
